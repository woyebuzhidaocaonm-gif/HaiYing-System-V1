<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="offshore_wind_turbine">

    <!-- Publish exact Gazebo model/link poses for the V9.2 dynamic TF bridge. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>

    <!-- HaiYing V8.1: 3 m/s常风 + 300~330 s附加9 m/s阵风 -->
    <plugin name="haiying_wind_plugin"
            filename="libgazebo_wind_plugin.so">
      <frameId>base_link</frameId>
      <robotNamespace/>
      <publishRate>2.0</publishRate>

      <windVelocityMean>3.0</windVelocityMean>
      <windVelocityMax>3.0</windVelocityMax>
      <windVelocityVariance>0</windVelocityVariance>
      <windDirectionMean>0 1 0</windDirectionMean>
      <windDirectionVariance>0</windDirectionVariance>

      <windGustStart>300</windGustStart>
      <windGustDuration>30</windGustDuration>
      <windGustVelocityMean>9.0</windGustVelocityMean>
      <windGustVelocityMax>9.0</windGustVelocityMax>
      <windGustVelocityVariance>0</windGustVelocityVariance>
      <windGustDirectionMean>0 1 0</windGustDirectionMean>
      <windGustDirectionVariance>0</windGustDirectionVariance>

      <windPubTopic>world_wind</windPubTopic>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode><solver><type>quick</type><iters>50</iters></solver><constraints><cfm>0.000001</cfm><erp>0.2</erp></constraints></ode>
    </physics>
    <!-- 自包含地面与光源：避免 model:// 下载阻塞离线实验室环境。 -->
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.15 0.20 0.24 1</ambient></material></visual></link></model>

    <!-- 可碰撞的简化塔筒与叶片；其 MoveIt 对应物由 wind_turbine_scene.py 发布。 -->
    <model name="turbine_tower"><static>true</static><pose>0.45 0 0.8 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.12</radius><length>1.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.12</radius><length>1.6</length></cylinder></geometry><material><ambient>0.75 0.75 0.78 1</ambient></material></visual></link></model>
    <model name="turbine_blade"><static>true</static><pose>0.72 0 1.35 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.1 0.10 0.08</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.1 0.10 0.08</size></box></geometry><material><ambient>0.92 0.92 0.95 1</ambient></material></visual></link></model>

    <!-- HAIYING_TEMP_TAKEOFF_STAND -->
    <!-- Stand center: x=0, y=-1.0 -->

    <model name="takeoff_stand_fl">
      <static>true</static>
      <pose>0.22 -0.78 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.07 0.07 0.25</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.07 0.07 0.25</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="takeoff_stand_fr">
      <static>true</static>
      <pose>0.22 -1.22 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.07 0.07 0.25</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.07 0.07 0.25</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="takeoff_stand_bl">
      <static>true</static>
      <pose>-0.22 -0.78 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.07 0.07 0.25</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.07 0.07 0.25</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="takeoff_stand_br">
      <static>true</static>
      <pose>-0.22 -1.22 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.07 0.07 0.25</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.07 0.07 0.25</size></box>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
